NEXUS_BASE_URL=https://uat.sentinel.unifo.in
# Optional: allows automatic headless re-login when the saved session expires.
# Leave empty if Nexus uses OTP/SSO; then run `python -m nexus_agent login` when told to.
NEXUS_USER=
NEXUS_PASSWORD=

# Daily update to Zoho (./nx post-update). Keep real values in .env only; never commit them.
# Cliq: the full incoming-webhook URL for the group/channel (includes its own key).
ZOHO_CLIQ_WEBHOOK_URL=
# Sprints (OAuth self client with the scope ZohoSprints.comments.CREATE)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SPRINTS_API=https://sprintsapi.zoho.in/zsapi
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SPRINTS_TEAM_ID=
ZOHO_SPRINTS_PROJECT_ID=
ZOHO_SPRINTS_MODULE_ID=
ZOHO_SPRINTS_ITEM_ID=
# Cliq group chat instead of a webhook: the id from the chat link (CT_...), needs the OAuth client above with the scope ZohoCliq.Webhooks.CREATE too.
ZOHO_CLIQ_CHAT_ID=
ZOHO_CLIQ_API=https://cliq.zoho.in/api/v2
